{
  "name": "saecula",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Saecula — an isometric historical real-time strategy game for the browser",
  "author": "Zoltán Dul (https://github.com/ZoliQua)",
  "license": "MIT",
  "homepage": "https://github.com/ZoliQua/Saecula-Strategy-Game#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZoliQua/Saecula-Strategy-Game.git"
  },
  "bugs": {
    "url": "https://github.com/ZoliQua/Saecula-Strategy-Game/issues"
  },
  "keywords": [
    "rts",
    "strategy-game",
    "isometric",
    "phaser",
    "typescript",
    "browser-game",
    "historical"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\""
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "miniplex": "^2.0.0",
    "pathfinding": "^0.4.18",
    "phaser": "^3.80.0",
    "zod": "^3.25.76",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pathfinding": "^0.0.9",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vitest": "^1.3.0"
  }
}
